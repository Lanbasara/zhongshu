# Local deployment example. Keep actual instance configuration outside the source checkout.
IMAGE=zhongshu:local
BIND_ADDRESS=127.0.0.1
PORT=8787
MEMORY_LIMIT=256m
CPU_LIMIT=0.5
# External HTTPS origin; credentials and instance settings stay outside Git.
ZHONGSHU_ORIGIN=https://workbench.example
# Native local development uses npm run dev and an explicit loopback-only HTTP exception.
# ZHONGSHU_DATA_DIR=/absolute/private/data/directory
